    "react-apexcharts": "^1.4.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.54.2",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.0",
    "npm-run-all": "^4.1.5",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0"
  },
  "scripts": {
    "css-compile": "tailwindcss build -i src/tailwind/tailwind.css -c src/tailwind/tailwind.config.js -o public/css/tailwind/tailwind.css",
    "css-minified": "tailwindcss build -i src/tailwind/tailwind.css -c src/tailwind/tailwind.config.js -o public/css/tailwind/tailwind.min.css --minify",
    "css": "npm-run-all --sequential css-*",
    "start": "node scripts/sync-ui.mjs && node scripts/sync-email.mjs && npm-run-all css && vite",
    "build": "node scripts/sync-ui.mjs && node scripts/sync-email.mjs && npm-run-all css && vite build",
    "test": "node --test packages/tokens/tokens.test.mjs",
    "tokens": "node packages/tokens/build.mjs",
    "sync-ui": "node scripts/sync-ui.mjs",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "pnpm": {
    "overrides": {
      "micromatch": "^4.0.8",
      "postcss": "^8.5.30",
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
